PORT=3000
NODE_ENV=development

# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=todo

# JWT Configuration (REQUIRED - separate secrets for access and refresh tokens)
JWT_ACCESS_SECRET=replace_with_a_secure_long_random_secret_for_access_token_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_secure_long_random_secret_for_refresh_token_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

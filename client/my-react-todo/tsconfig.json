{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true
  },
  "include": [
    "my-project/src/**/*"
  ],
  "exclude": [
    "src",
    "test",
    "node_modules",
    "dist",
    "my-project/node_modules",
    "my-project/dist"
  ]
}
